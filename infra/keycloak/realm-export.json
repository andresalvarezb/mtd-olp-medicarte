{
  "realm": "authorization",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "authorization-api",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "authorization-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "authorization-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "authorization-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "foundation-admin",
      "email": "admin@example.test",
      "firstName": "Foundation",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "foundation-admin",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "olp-operator",
      "email": "olp@example.test",
      "firstName": "OLP",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "olp-operator", "temporary": false }]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "suspended-user",
      "email": "suspended@example.test",
      "firstName": "Suspended",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "suspended-user", "temporary": false }]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "unknown-local-user",
      "email": "unknown@example.test",
      "firstName": "Unknown",
      "lastName": "Local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "unknown-local-user", "temporary": false }]
    }
  ]
}
