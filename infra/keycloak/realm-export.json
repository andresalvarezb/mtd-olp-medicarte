{
  "realm": "authorization",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "authorization-api",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "authorization-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["http://localhost:3002"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "authorization-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "authorization-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "authorization-admin",
      "enabled": true,
      "secret": "local-dev-admin-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "id": "99999999-9999-4999-8999-999999999999",
      "username": "service-account-authorization-admin",
      "enabled": true,
      "serviceAccountClientId": "authorization-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-clients"]
      }
    },
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "foundation-admin",
      "email": "admin@example.test",
      "firstName": "Foundation",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "foundation-admin",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "olp-operator",
      "email": "olp@example.test",
      "firstName": "OLP",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "olp-operator",
          "temporary": false
        }
      ]
    },
    {
      "id": "45555555-5555-4555-8555-555555555555",
      "username": "medicarte-operator",
      "email": "medicarte@example.test",
      "firstName": "Medicarte",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "medicarte-operator",
          "temporary": false
        }
      ]
    }
  ]
}
