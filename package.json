{
  "name": "authorization-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "eslint apps packages tests --max-warnings=0",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "vitest run --config tests/vitest.integration.config.ts",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @authorization/database db:generate",
    "db:migrate": "pnpm --filter @authorization/database db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "pg": "8.16.3",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
