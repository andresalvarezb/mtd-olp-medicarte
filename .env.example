NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://authorization:authorization@localhost:15432/authorization
REDIS_URL=redis://localhost:6379
# Autenticación local (ADR-026). AUTH_JWT_SECRET: hex de 64+ chars o base64url
# de 32+ bytes. AUTH_BOOTSTRAP_ADMIN_* crea/recupera el primer administrador
# local solo cuando todavía no existe un MTD_ADMIN activo con contraseña.
AUTH_JWT_SECRET=
AUTH_JWT_TTL_SECONDS=28800
AUTH_BOOTSTRAP_ADMIN_USERNAME=foundation-admin
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# AUTH_BOOTSTRAP_MTD_GENERAL_PASSWORD=
# AUTH_BOOTSTRAP_MTD_AUDITORIA_PASSWORD=
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
SCHEDULER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
GOOGLE_DRIVE_AUDIT_SYNC_RECHECK_MS=43200000
GOOGLE_DRIVE_AUDIT_SYNC_CHANGE_FEED_ENABLED=true
GOOGLE_DRIVE_AUDIT_SYNC_POLL_INTERVAL_MS=60000
GOOGLE_DRIVE_AUDIT_SYNC_BATCH_SIZE=25
GOOGLE_DRIVE_AUDIT_SYNC_ERROR_RETRY_MS=300000
GOOGLE_DRIVE_AUDIT_SYNC_ERROR_RETRY_MAX_MS=43200000
MTDOM_PATIENT_LOOKUP_ENABLED=false
MTDOM_PATIENT_LOOKUP_SYNC_ENABLED=false
# Optional comma-separated local patient UUID allowlist. Empty means all patients
# already linked to MEDICARTE authorizations; never put document numbers here.
MTDOM_PATIENT_LOOKUP_SYNC_PATIENT_IDS=
MTDOM_DP07_APPROVED=false
MTDOM_PATIENT_IDENTITY_POLICY_VERSION=
# La política temporal aprobada para la AUTO COMPENSAR es COMPENSAR_DOCUMENT_TYPE_CC_ONLY_V1.
# Configure MTDOM_PATIENTS_API_TOKEN only in a secret manager after formal approval.
MTDOM_PATIENTS_TIMEOUT_MS=5000
PATIENT_MASTER_ACCESS_ENABLED=false
PATIENT_MASTER_SCOPE_POLICY_APPROVED=false
PATIENT_MASTER_DP07_APPROVED=false
PATIENT_MASTER_ENRICHMENT_QUEUE_ENABLED=false
PATIENT_MASTER_SCOPE_POLICY_VERSION=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
IMPORT_MAX_FILE_BYTES=20971520
# Solo autorizaciones: 50 MiB. No hay limite de filas por archivo.
AUTHORIZATION_IMPORT_MAX_FILE_BYTES=52428800
IMPORT_PROCESSOR_VERSION=2
IMPORT_QUEUE_CONCURRENCY=3
BULK_QUEUE_CONCURRENCY=3
MIPRES_BASE_URL=https://wsmipres.sispro.gov.co/WSSUMMIPRESNOPBS
MIPRES_NIT=
MIPRES_INITIAL_TOKEN=
MIPRES_TIMEOUT_MS=15000
MIPRES_HTTP_RETRIES=2
MIPRES_CIRCUIT_BREAKER_THRESHOLD=5
MIPRES_CIRCUIT_BREAKER_COOLDOWN_MS=30000
MIPRES_QUEUE_CONCURRENCY=2
MIPRES_MANUAL_RECHECK_DAILY_LIMIT=5
# Google Drive (auditoría de facturación) - misma cuenta de servicio usada para Sheets
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-drive-audit-service-account.json
# GOOGLE_DRIVE_AUDIT_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_AUDIT_ROOT_FOLDER_IDS=
# Google Sheets - registro de recaudos de cuota moderadora
# GOOGLE_SHEETS_MODERATOR_FEE_ID=<ID_DEL_SPREADSHEET>
# GOOGLE_SHEETS_MODERATOR_FEE_SHEET_NAME=PRUEBAS
