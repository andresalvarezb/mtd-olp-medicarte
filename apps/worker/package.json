    "@nestjs/core": "11.2.8",
    "@sentry/node": "10.78.0",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "googleapis": "^182.0.0",
    "ioredis": "5.11.1",
    "pino": "9.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/node": "22.18.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
