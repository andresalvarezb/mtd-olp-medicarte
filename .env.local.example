# ============================================================
# MTD OLP MEDICARTE - ENTORNO LOCAL
# ============================================================

COMPOSE_PROJECT_NAME=mtd-olp-medicarte-local
LOCAL_IMAGE_PREFIX=mtd-olp-medicarte

# Dirección del host donde Docker publica los servicios.
BIND_HOST=127.0.0.1
PUBLIC_HOST=localhost

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=authorization_local
POSTGRES_USER=authorization
POSTGRES_PASSWORD=authorization
POSTGRES_HOST_PORT=15432

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_HOST_PORT=16379

# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------

API_HOST_PORT=3001
WEB_HOST_PORT=3002
MIPRES_MOCK_HOST_PORT=18090

LOG_LEVEL=info

# ------------------------------------------------------------
# Auth local
# ------------------------------------------------------------

AUTH_JWT_SECRET=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0
AUTH_JWT_TTL_SECONDS=28800

AUTH_BOOTSTRAP_ADMIN_USERNAME=foundation-admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=foundation-admin

# ------------------------------------------------------------
# Importaciones / worker
# ------------------------------------------------------------

IMPORT_MAX_FILE_BYTES=20971520
IMPORT_PROCESSOR_VERSION=2
IMPORT_QUEUE_CONCURRENCY=3
BULK_QUEUE_CONCURRENCY=3

SCHEDULER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
RECONCILIATION_SCHEDULER_ENABLED=false

# ------------------------------------------------------------
# MIPRES MOCK LOCAL
# ------------------------------------------------------------

MIPRES_NIT=900123456
MIPRES_INITIAL_TOKEN=initial-secret
MIPRES_MANUAL_RECHECK_DAILY_LIMIT=3

LOCAL_DB_BACKUP_PATH=
